{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:token-distillation:causal-dual-teacher-dataset:v1",
  "title": "Implemented immutable causal CZSC, W32 and ICT dataset manifest",
  "description": "Actual five-split JSONL dataset. The loader also verifies hashes, duplicate origins, raw provenance, context-only normalization, teacher schema consistency and label maturity. Draft retrospective splits do not establish an unused investment holdout.",
  "type": "object",
  "required": ["schema", "sample_schema", "universe", "frequency", "symbols", "start", "end", "label_through", "context_length", "horizon", "features", "time_feature_order", "stride", "max_per_split", "direction_threshold", "config_sha256", "config", "source_identity", "calendar_identity", "symbol_snapshots", "generator_sha256", "splits", "split_ranges", "split_status", "holdout_claim", "population_sha256", "total_samples", "admission", "causal_contract", "manifest_sha256"],
  "properties": {
    "schema": {"const": "causal_dual_teacher_dataset_v1"},
    "sample_schema": {"const": "causal_teacher_student_sample_v1"},
    "universe": {"const": "sh_sz_a_v1"},
    "frequency": {"const": "1d"},
    "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:(?:60|68)\\d{4}\\.SH|(?:00|30)\\d{4}\\.SZ)$"}},
    "start": {"$ref": "#/$defs/date"},
    "end": {"$ref": "#/$defs/date"},
    "label_through": {"$ref": "#/$defs/date"},
    "context_length": {"type": "integer", "minimum": 16, "maximum": 512},
    "horizon": {"type": "integer", "minimum": 1, "maximum": 10},
    "features": {"const": ["open", "high", "low", "close", "volume", "amount"]},
    "time_feature_order": {"const": ["minute", "hour", "weekday", "day", "month"]},
    "stride": {"type": "integer", "minimum": 1},
    "max_per_split": {"type": ["integer", "null"], "minimum": 1},
    "direction_threshold": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "config": {"type": "object"},
    "source_identity": {"type": "object", "required": ["scope", "code_sha256"], "properties": {"scope": {"const": "sh_sz_a_v1"}, "code_sha256": {"$ref": "#/$defs/sha256"}}},
    "calendar_identity": {"type": "object", "required": ["run_id", "source", "independent_from_market_bars", "file_sha256", "dates_hash", "source_artifacts"], "properties": {"independent_from_market_bars": {"const": true}, "file_sha256": {"$ref": "#/$defs/sha256"}, "dates_hash": {"$ref": "#/$defs/sha256"}, "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}}}},
    "symbol_snapshots": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["sha256", "row_count", "first_session", "last_session"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "row_count": {"type": "integer", "minimum": 1}, "first_session": {"$ref": "#/$defs/date"}, "last_session": {"$ref": "#/$defs/date"}}}},
    "generator_sha256": {"$ref": "#/$defs/sha256"},
    "splits": {"$ref": "#/$defs/splitShards"},
    "split_ranges": {"$ref": "#/$defs/splitRanges"},
    "split_status": {"enum": ["draft_not_frozen", "pilot_retrospective", "ablation_retrospective", "frozen"]},
    "holdout_claim": {"type": "string"},
    "population_sha256": {"$ref": "#/$defs/sha256"},
    "total_samples": {"type": "integer", "minimum": 1},
    "teacher_schemas": {"type": "object", "required": ["w32", "ict", "czsc"], "additionalProperties": {"type": "object", "required": ["schema", "continuous_names", "event_names", "structure_dim"], "properties": {"schema": {"type": "string"}, "schema_sha256": {"type": ["string", "null"]}, "continuous_names": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "event_names": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "structure_dim": {"type": "integer", "minimum": 0}}}},
    "teacher_coverage": {"type": "object", "required": ["by_split", "overall"], "description": "Per-teacher known and total target counts; inspect coverage before training.", "properties": {"by_split": {"type": "object"}, "overall": {"type": "object", "required": ["w32", "ict", "czsc"], "additionalProperties": {"type": "object", "required": ["continuous_known", "continuous_total", "event_known", "event_total", "structure_known", "structure_total", "status"], "properties": {"status": {"enum": ["valid_supervision_present", "no_valid_supervision"]}}}}}},
    "admission": {"type": "object", "required": ["candidate_counts", "attempted_counts", "skipped_counts", "origins_outside_splits", "rejection_examples"], "properties": {"candidate_counts": {"$ref": "#/$defs/splitCounts"}, "attempted_counts": {"$ref": "#/$defs/splitCounts"}, "skipped_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "origins_outside_splits": {"type": "integer", "minimum": 0}, "rejection_examples": {"type": "array", "maxItems": 50}}},
    "causal_contract": {"type": "object", "required": ["source_read_only", "teachers_share_frozen_student_context", "context_only_normalization", "split_end_label_maturity_purge", "unknown_is_masked_null", "tokenizer_loaded", "training_started", "formal_qualified", "survivorship_and_corporate_actions_audited"], "properties": {"source_read_only": {"const": true}, "teachers_share_frozen_student_context": {"const": true}, "context_only_normalization": {"const": true}, "split_end_label_maturity_purge": {"const": true}, "unknown_is_masked_null": {"const": true}, "tokenizer_loaded": {"const": false}, "training_started": {"const": false}, "formal_qualified": {"const": false}, "survivorship_and_corporate_actions_audited": {"const": false}}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "shard": {"type": "object", "required": ["path", "sha256", "row_count", "first_as_of", "last_as_of"], "properties": {"path": {"type": "string", "pattern": "^(train|tune|calibration|policy|holdout)\\.jsonl$"}, "sha256": {"$ref": "#/$defs/sha256"}, "row_count": {"type": "integer", "minimum": 0}, "first_as_of": {"type": ["string", "null"]}, "last_as_of": {"type": ["string", "null"]}}},
    "splitShards": {"type": "object", "required": ["train", "tune", "calibration", "policy", "holdout"], "additionalProperties": false, "properties": {"train": {"$ref": "#/$defs/shard"}, "tune": {"$ref": "#/$defs/shard"}, "calibration": {"$ref": "#/$defs/shard"}, "policy": {"$ref": "#/$defs/shard"}, "holdout": {"$ref": "#/$defs/shard"}}},
    "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "format": "date-time"}},
    "splitRanges": {"type": "object", "required": ["train", "tune", "calibration", "policy", "holdout"], "additionalProperties": false, "properties": {"train": {"$ref": "#/$defs/range"}, "tune": {"$ref": "#/$defs/range"}, "calibration": {"$ref": "#/$defs/range"}, "policy": {"$ref": "#/$defs/range"}, "holdout": {"$ref": "#/$defs/range"}}},
    "splitCounts": {"type": "object", "required": ["train", "tune", "calibration", "policy", "holdout"], "additionalProperties": {"type": "integer", "minimum": 0}}
  },
  "$comment": "teacher_schemas and teacher_coverage remain optional for compatibility with the first immutable context-64 pilot; current generation always writes both. All five shards are present even when some are empty. A trainer must reject inadequate split or teacher coverage before optimization."
}
